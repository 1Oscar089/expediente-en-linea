*-firebase-adminsdk-*.json
serviceAccountKey.json

# ── Logs ──
logs/
*.log
npm-debug.log*

# ── Editor y sistema operativo ──
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
